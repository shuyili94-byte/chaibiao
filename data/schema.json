{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "拆表MVP年度及中期累计合并报表输入",
  "description": "普通非金融企业、同一合并范围、人民币百万元。支持年度及标准季末报告日，利润及现金流全部采用本年初至报告日累计口径，不冒称单季度、不机械年化。期初资产及权益均取上年12月31日。source记录来源声明，计算内核不提供鉴证。cash_begin/cash_end必须为现金及现金等价物。capex_cash_outflow为正数现金支出。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company",
    "period",
    "scope",
    "unit",
    "source",
    "statements"
  ],
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "code": {
      "type": "string",
      "maxLength": 50
    },
    "period": {
      "type": "string",
      "pattern": "^(19|20)[0-9]{2}(-(03-31|06-30|09-30|12-31))?$",
      "description": "年度YYYY（兼容原输入），或YYYY-03-31一季报、YYYY-06-30半年报、YYYY-09-30三季报、YYYY-12-31年报。利润及现金流均为1月1日至该报告日累计；选择已有披露期间由数据提供层负责。"
    },
    "scope": {
      "const": "consolidated"
    },
    "industry": {
      "const": "general",
      "default": "general",
      "description": "普通非金融企业"
    },
    "unit": {
      "const": "CNY_million",
      "description": "人民币百万元；亿元×100，万元÷100"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document"
      ],
      "properties": {
        "kind": {
          "enum": [
            "demo",
            "manual",
            "public_provider"
          ],
          "description": "demo=虚构演示；manual=用户录入；public_provider=公开数据服务商，原始披露及数据真实性未经计算内核鉴证"
        },
        "document": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "description": "空字符串或HTTP(S)链接；程序不会访问该链接"
        },
        "page": {
          "type": "string",
          "maxLength": 300,
          "description": "页码或附注编号，可空"
        },
        "provider": {
          "type": "string",
          "maxLength": 200,
          "description": "可选，公开数据服务商名称"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 80,
          "description": "可选，数据获取时间文本，建议ISO8601含时区，如2026-10-22T12:00:00Z"
        }
      }
    },
    "statements": {
      "type": "object",
      "additionalProperties": false,
